	<flow name="post:\createAccount:application\json:vitech-bank-customer-acct-creation-config" doc:id="2645f44f-2017-4da9-b51d-d2eaf6b49962">
        <logger level="INFO" doc:name="Logger" doc:id="e1434f51-1418-4e03-bbf1-e86bea44952d" message="----------------------------The account creation flow has started------------------------"/>
		<set-variable value="#[attributes.queryParams.customerName]" doc:name="customerName" doc:id="7874e44b-65e3-43e6-8d1a-75b475964613" variableName="customerName"/>
		<set-variable value="#[attributes.queryParams.bank]" doc:name="bank" doc:id="10df5018-1cd3-4daa-9fbc-875bf3315f35" variableName="bank"/>
		<set-variable value='#[attributes.queryParams."type"]' doc:name="type" doc:id="c3e0147f-f57d-4d13-8f5a-106186b61341" variableName="type"/>
		<set-variable value="#[attributes.queryParams.branchName]" doc:name="branchName" doc:id="24876d25-5aba-4982-9473-346508186ab3" variableName="branchName"/>
		<set-variable value="#[payload.accountNum]" doc:name="acctNum" doc:id="20443ee1-22c6-4c94-adc9-ced6efaa8f4f" variableName="acctNum"/>
		<set-variable value="#[[]]" doc:name="emptyList" doc:id="5b25ed35-375c-4423-95a7-a8ed0d47ab2c" variableName="inppayload"/>
		<set-variable value="#[%dw 2.0&#10;output application/json&#10;---&#10;vars.inppayload &lt;&lt; payload]" doc:name="add the inputpayload" doc:id="19518259-3826-44f7-a539-6314ece273e1" variableName="inpPayload"/>
		<db:select doc:id="d227dc5f-5d74-404f-a905-424dccb4246d" config-ref="Database_Config">
			<db:sql ><![CDATA[select bankName, custAccNum from Bank_Transactions where bankName =:bankName and custAccNum =:custAccNum;]]></db:sql>
			<db:input-parameters ><![CDATA[#[{
	"bankName": vars.bank,
	"custAccNum":payload.accountNum
}]]]></db:input-parameters>
		</db:select>
		<choice doc:name="Choice" doc:id="13246137-c72c-4aa9-907d-635989708875" >
			<when expression="#[sizeOf(payload) &gt;=1]">
				<ee:transform doc:name="Transform Message" doc:id="603e52a1-e1a5-4f2a-94ef-782036f44484" >
					<ee:message >
						<ee:set-payload ><![CDATA[%dw 2.0
output application/json
---
{
	(payload map {
		"message": "account " ++ $.custAccNum ++ " already exist "
	})
}]]></ee:set-payload>
					</ee:message>
				</ee:transform>
				<logger level="INFO" doc:name="Logger" doc:id="20975380-9377-4c8b-bbba-bf2ff116724c" message="---------------The Customer account already exists in Database--------------------------"/>
			</when>
			<otherwise >
				<db:insert doc:name="Insert" doc:id="5a0cc458-5841-4277-a121-30fc78d11f0e" config-ref="Database_Config">
					<db:sql ><![CDATA[insert into Bank_Transactions (custName, custAccNum, atmPin, bankName, accountType, ifscCode, branchName, transactionTimeStamp, mailld, phoneNumber) values (:custName, :custAccNum, :atmPin, :bankName, :accountType, :ifscCode, :branchName, :transactionTimeStamp, :mailId, :phoneNumber);]]></db:sql>
					<db:input-parameters ><![CDATA[#[{
	(vars.inpPayload map {
		"custName": vars.customerName,
		"custAccNum": $.accountNum,
		"atmPin": $.atmPin,
		"bankName": vars.bank,
		"accountType": vars."type",
		"ifscCode": $.ifscCode,
		"branchName": vars.branchName,
		"transactionTimeStamp": now(),
		"mailId": $.mailId,
		"phoneNumber": $.contact,
	})
}]]]></db:input-parameters>
				</db:insert>
				<flow-ref doc:name="Flow Reference" doc:id="cee5a140-e7b6-48a5-9ee0-bb4df366c9d7" name="vitech-bank-customer-gmail-creationFlow" />
				<ee:transform doc:name="Transform Message">
            <ee:message>
                <ee:set-payload><![CDATA[%dw 2.0
output application/json
---

{
	(vars.inppayload map {
		"status": "Account created successfully with account Number "  
	})
}

]]></ee:set-payload>
            </ee:message>
        </ee:transform>
				<logger level="INFO" doc:name="Logger" doc:id="6f381d34-1434-41ba-bdee-9bc8f4dbfb7b" message="-------------- Account created successfully-----------------"/>
			</otherwise>
		</choice>
    </flow>
</mule>
