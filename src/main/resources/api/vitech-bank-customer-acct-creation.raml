#%RAML 1.0
title: vitech-bank-customer-acct-creation
description: API for bank customer account creATION
version: V1
protocols:
  - HTTP
  - HTTPS
securitySchemes:
  secure: !include /Security-Schema/securityScheme.raml
securedBy:
  - secure 

/createAccount :
  post:
    queryParameters:
      customerName:
        required: true
        maxLength: 45
        minLength: 4
      bank :
        required: true
        enum:
          - ICICI
          - AXIS
          - HDFC
          - SBI 
      type :
        required: true
        enum:
          - savings
          - current
      branchName :
        required: true
        minLength: 4
        maxLength: 10
    body:
      application/json:
        type: !include /Datatypes/inputDataTypes.raml
        example: !include /examples/request/inputRequestExample.raml
           
    responses:
      201:
        body:
          application/json:  
            example: !include /examples/response/successResponse.raml
            

    